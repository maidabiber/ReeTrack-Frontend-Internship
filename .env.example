# Copy this file to .env (or .env.local) and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL used for API calls. Defaults to a relative "/api" path, which is
# proxied to the backend by vite.config.ts during local development.
VITE_API_BASE_URL=/api

# SignalR hub URL for real-time in-app notifications. Defaults to a relative
# "/hubs/notifications" path, which vite.config.ts proxies to the backend.
VITE_HUB_URL=/hubs/notifications
